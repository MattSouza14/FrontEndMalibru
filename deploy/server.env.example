# Copie para /opt/malibru-frontend/deploy.env no servidor.
# Formato KEY=value literal, sem aspas ou expansão de variáveis.
IMAGE_REPOSITORY=ghcr.io/mattsouza14/frontendmalibru
APP_NAME=malibru-frontend
BACKEND_ORIGIN=http://backend:8080
DOCKER_NETWORK=malibru
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081
# Endpoint público e somente leitura para verificar o encaminhamento da API.
# Defina como vazio para validar somente o frontend (documente essa decisão).
API_HEALTH_PATH=/api/empresas
